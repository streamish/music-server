{
  "author": "",
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@sequelize/sqlite3": "^7.0.0-alpha.48",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "music-metadata": "^11.14.0",
    "node-vibrant": "^4.0.4",
    "openapi-fetch": "^0.17.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "typescript-guid": "^1.0.3",
    "umzug": "2.3"
  },
  "description": "Streamish Music Server; a REST API for managing and streaming music libraries with compatible interfaces for various smartphone apps.",
  "devDependencies": {
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-check-file": "^2.6.2",
    "eslint-plugin-folders": "^1.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.3",
    "typescript-eslint": "^8.20.0",
    "xml2js": "^0.6.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 60000,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "verbose": true
  },
  "license": "UNLICENSED",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "name": "music-server",
  "private": true,
  "scripts": {
    "build": "npx nest build",
    "generate:endpoint": "bash generators/nestjs-endpoint.sh",
    "generate:entity": "bash generators/nestjs-entity.sh",
    "generate:migration": "bash generators/sequelize-migration.sh",
    "generate:seeder": "bash generators/sequelize-seeder.sh",
    "lint:json": "for x in `find . -type f -name \"*.json\" -not -path \"./node_modules/*\" -not -path \"./.git/*\" -not -path \"./dist/*\"`; do npx sort-json-keys \"./$x\"; done",
    "lint": "npx eslint . --fix",
    "openapi:generate": "npx openapi-typescript http://localhost:7100/swagger.json -o ./src/types/api-schema.ts --enum --alphabetize --export-type",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "rebuild": "rm -f *.db && npm run build && npm run sequelize:migrate && npm run sequelize:seed:all",
    "sequelize:migrate": "npx sequelize-cli db:migrate",
    "sequelize:seed:all": "npx sequelize-cli db:seed:all",
    "sequelize:seed:create": "npx sequelize-cli seed:create --seeders-path ./src/database/seeders --name ",
    "sequelize:seed": "npx sequelize-cli db:seed",
    "start:debug": "npx dotenv -e .env -- npx nest start --debug --watch",
    "start:dev": "npx dotenv -e .env -- npx nest start --watch",
    "start:prod": "npx node dist/main",
    "start:test": "npx dotenv -e .env.test -- npx nest start",
    "test": "npx dotenv -e .env.test npx jest"
  },
  "version": "0.0.5"
}
