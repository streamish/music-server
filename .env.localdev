# server settings
CORS_ORIGINS=http://localhost:8000
DATABASE_PATH=music-server.db
JWT_SECRET=a-different-secret-key-for-jwt-sessions
NODE_ENV=development
SWAGGER_ENABLED=true
TZ=UTC

# run sequelize migrations and seeders on startup, note that
# seeders will only run if the database is empty
BUILD_DATABASE=true

# default administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_ROOT_PATH=/library1,/library2,/library3

# default user (or disable)
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=user
DEFAULT_USER_ROOT_PATH=/library4,/library5
# DISABLE_DEFAULT_USER=true

# Server
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=7000
LAN_SERVER_PORT=7000
LAN_SERVER_ADDRESS=192.168.0.1
WAN_SERVER_PORT=7000
WAN_SERVER_ADDRESS=192.168.0.1

# Synology AudioStation / DS Audio
SYNOLOGY_AUDIOSTATION_ENABLED=true
SYNOLOGY_PUBLIC_KEY_PATH=${PWD}/certs/public.pem
SYNOLOGY_PRIVATE_KEY_PATH=${PWD}/certs/private.pem

# QNAP Music Station / QMusic
QNAP_MUSIC_STATION_ENABLED=true
QNAP_CUID=a7c94e21f08b6d3e5c1a9f7428b0d6e3
